{
  "sample_rate": 16000,
  "mono": true,
  "n_fft": 400,
  "hop_length": 160,
  "win_length": 400,
  "window": "hann",
  "n_mels": 64,
  "fmin": 20.0,
  "fmax": 8000.0,
  "log_offset": 1e-06,
  "mel_scale": "htk",
  "spectrogram_norm": "per_bin_train_zscore",
  "window_seconds": 4.0,
  "max_windows_per_recording": 8,
  "pad_mode": "zero",
  "min_duration_s": 0.5,
  "max_duration_s": 600.0,
  "conv_channels": [
    8,
    16,
    32
  ],
  "kernel_size": 3,
  "dropout": 0.5,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 32,
  "max_epochs": 40,
  "early_stopping_patience": 8,
  "class_weighted_loss": true,
  "calibration": "platt_on_inner_val_recording",
  "threshold_selection": "max_f1_on_inner_val_recording",
  "n_splits": 5,
  "n_repeats": 5,
  "base_seed": 42
}